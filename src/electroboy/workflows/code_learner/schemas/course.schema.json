{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electroboy.dev/schemas/code-learner/course-v1.schema.json",
  "title": "ElectroBoy Code Learner Course Record",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "id",
    "analysis_run_id",
    "repository_revision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"enum": ["document", "section"]},
    "id": {"type": "string", "minLength": 1},
    "analysis_run_id": {"type": "string", "minLength": 1},
    "repository_revision": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "course_mode": {"enum": ["architecture", "module", "function"]},
    "scope_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "coverage_topics": {"$ref": "#/$defs/stringArray"},
    "parent_id": {"type": "string", "minLength": 1},
    "heading_level": {"type": "integer", "minimum": 1},
    "order": {"type": "integer", "minimum": 0},
    "body": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "call_edge_confidence": {"type": "object"},
    "detail_level": {"enum": ["architecture", "module", "function"]},
    "confidence": {
      "oneOf": [
        {"enum": ["verified", "high", "medium", "low", "unknown"]},
        {"type": "number", "minimum": 0, "maximum": 1}
      ]
    },
    "previous_section_id": {"type": ["string", "null"]},
    "next_section_id": {"type": ["string", "null"]},
    "return_section_id": {"type": ["string", "null"]},
    "deep_dive_ids": {"$ref": "#/$defs/stringArray"},
    "deep_dive_targets": {
      "type": "array",
      "items": {"$ref": "#/$defs/deepDiveTarget"}
    },
    "prerequisite_section_ids": {"$ref": "#/$defs/stringArray"},
    "knowledge_entity_ids": {"$ref": "#/$defs/stringArray"},
    "relationship_ids": {"$ref": "#/$defs/stringArray"},
    "runtime_flow_ids": {"$ref": "#/$defs/stringArray"},
    "diagnostic_ids": {"$ref": "#/$defs/stringArray"},
    "related_module_ids": {"$ref": "#/$defs/stringArray"},
    "related_symbol_ids": {"$ref": "#/$defs/stringArray"},
    "source_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceReference"}
    },
    "diagrams": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagram"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"record_type": {"const": "document"}}},
      "then": {
        "required": ["title", "course_mode", "scope_id", "status"]
      }
    },
    {
      "if": {"properties": {"record_type": {"const": "section"}}},
      "then": {
        "required": [
          "parent_id",
          "heading_level",
          "order",
          "title",
          "body",
          "detail_level",
          "knowledge_entity_ids",
          "relationship_ids",
          "runtime_flow_ids",
          "related_module_ids",
          "related_symbol_ids",
          "prerequisite_section_ids",
          "source_refs",
          "confidence"
        ]
      }
    }
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "sourceReference": {
      "type": "object",
      "required": ["path", "start_line", "end_line", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "symbol": {"type": "string"},
        "reason": {"type": "string", "minLength": 1},
        "revision": {"type": "string"}
      },
      "additionalProperties": true
    },
    "diagram": {
      "type": "object",
      "required": ["id", "type", "question"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "deepDiveTarget": {
      "type": "object",
      "required": ["target_type", "target_id"],
      "properties": {
        "target_type": {
          "enum": ["architecture", "module", "component", "function"]
        },
        "target_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
