{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electroboy.dev/schemas/code-learner/knowledge-v1.schema.json",
  "title": "ElectroBoy Code Learner Knowledge Record",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "id",
    "analysis_run_id",
    "repository_revision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {
      "enum": [
        "knowledge_manifest",
        "entity",
        "relationship",
        "runtime_flow",
        "diagnostic",
        "knowledge_request"
      ]
    },
    "id": {"type": "string", "minLength": 1},
    "analysis_run_id": {"type": "string", "minLength": 1},
    "repository_revision": {"type": "string", "minLength": 1},
    "repository_name": {"type": "string", "minLength": 1},
    "scope_path": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "entity_count": {"type": "integer", "minimum": 0},
    "relationship_count": {"type": "integer", "minimum": 0},
    "flow_count": {"type": "integer", "minimum": 0},
    "diagnostic_count": {"type": "integer", "minimum": 0},
    "kind": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "parent_id": {"type": ["string", "null"]},
    "from_id": {"type": "string", "minLength": 1},
    "to_id": {"type": "string", "minLength": 1},
    "participant_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/flowStep"}
    },
    "severity": {"enum": ["info", "warning", "error"]},
    "message": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "missing_facts": {"type": "string", "minLength": 1},
    "related_record_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "confidence": {
      "oneOf": [
        {"enum": ["verified", "high", "medium", "low", "unknown"]},
        {"type": "number", "minimum": 0, "maximum": 1}
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceReference"}
    },
    "attributes": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"record_type": {"const": "knowledge_manifest"}}},
      "then": {
        "required": [
          "repository_name",
          "scope_path",
          "status",
          "entity_count",
          "relationship_count",
          "flow_count",
          "diagnostic_count"
        ]
      }
    },
    {
      "if": {"properties": {"record_type": {"const": "entity"}}},
      "then": {
        "required": ["kind", "name", "summary", "source_refs", "confidence"],
        "properties": {
          "kind": {
            "enum": [
              "repository",
              "module",
              "extension-family",
              "implementation",
              "entry-point",
              "interface",
              "symbol",
              "data-type",
              "state-store",
              "process",
              "external-system",
              "test-surface",
              "build-target"
            ]
          },
          "source_refs": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"record_type": {"const": "relationship"}}},
      "then": {
        "required": [
          "kind",
          "from_id",
          "to_id",
          "summary",
          "source_refs",
          "confidence"
        ],
        "properties": {
          "kind": {
            "enum": [
              "contains",
              "calls",
              "implements",
              "extends",
              "depends-on",
              "creates",
              "owns",
              "reads",
              "writes",
              "publishes",
              "subscribes",
              "sends-to",
              "receives-from",
              "configures",
              "selects",
              "registers",
              "dispatches-to",
              "persists-to",
              "tests",
              "deploys"
            ]
          },
          "source_refs": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"record_type": {"const": "runtime_flow"}}},
      "then": {
        "required": [
          "name",
          "kind",
          "participant_ids",
          "steps",
          "source_refs",
          "confidence"
        ],
        "properties": {"source_refs": {"minItems": 1}}
      }
    },
    {
      "if": {"properties": {"record_type": {"const": "diagnostic"}}},
      "then": {"required": ["severity", "message"]}
    },
    {
      "if": {"properties": {"record_type": {"const": "knowledge_request"}}},
      "then": {
        "required": ["scope_id", "missing_facts", "status"],
        "properties": {
          "status": {"enum": ["open", "resolved", "blocked", "dismissed"]}
        }
      }
    }
  ],
  "$defs": {
    "sourceReference": {
      "type": "object",
      "required": ["path", "start_line", "end_line", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "symbol": {"type": "string"},
        "reason": {"type": "string", "minLength": 1},
        "revision": {"type": "string"}
      },
      "additionalProperties": true
    },
    "flowStep": {
      "type": "object",
      "required": ["order", "from_id", "to_id", "action"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "from_id": {"type": "string", "minLength": 1},
        "to_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "relationship_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
