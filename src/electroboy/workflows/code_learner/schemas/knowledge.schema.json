{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electroboy.dev/schemas/code-learner/knowledge-v1.schema.json",
  "title": "ElectroBoy Code Learner Knowledge Record",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "id",
    "analysis_run_id",
    "repository_revision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {
      "enum": [
        "knowledge_manifest",
        "entity",
        "relationship",
        "runtime_flow",
        "diagnostic",
        "knowledge_request"
      ]
    },
    "id": {"type": "string", "minLength": 1},
    "analysis_run_id": {"type": "string", "minLength": 1},
    "repository_revision": {"type": "string", "minLength": 1},
    "confidence": {
      "oneOf": [
        {"enum": ["verified", "high", "medium", "low", "unknown"]},
        {"type": "number", "minimum": 0, "maximum": 1}
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceReference"}
    }
  },
  "$defs": {
    "sourceReference": {
      "type": "object",
      "required": ["path", "start_line", "end_line", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "symbol": {"type": "string"},
        "reason": {"type": "string", "minLength": 1},
        "revision": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
