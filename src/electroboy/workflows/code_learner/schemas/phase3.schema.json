{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electroboy.local/schemas/code-learner-phase3.schema.json",
  "title": "ElectroBoy Code Learner Phase 3 Record",
  "oneOf": [
    { "$ref": "#/$defs/source_file" },
    { "$ref": "#/$defs/component_candidate" },
    { "$ref": "#/$defs/overlap_group" },
    { "$ref": "#/$defs/component_reconciliation" },
    { "$ref": "#/$defs/component" },
    { "$ref": "#/$defs/file_disposition" },
    { "$ref": "#/$defs/source_manifest" },
    { "$ref": "#/$defs/component_manifest" },
    { "$ref": "#/$defs/module_manifest" },
    { "$ref": "#/$defs/file_coverage" },
    { "$ref": "#/$defs/module" },
    { "$ref": "#/$defs/module_relationship" },
    { "$ref": "#/$defs/architecture_knowledge" },
    { "$ref": "#/$defs/module_knowledge" },
    { "$ref": "#/$defs/function_knowledge" },
    { "$ref": "#/$defs/knowledge_request" },
    { "$ref": "#/$defs/diagnostic" }
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": ["schema_version", "record_type"],
      "properties": {
        "schema_version": { "const": 1 },
        "record_type": { "type": "string", "minLength": 1 },
        "repository_revision": { "type": "string" }
      }
    },
    "symbol_locator": {
      "type": "object",
      "required": ["file_id", "name", "kind", "start_line", "end_line"],
      "properties": {
        "file_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" },
        "language": { "type": "string" },
        "signature": { "type": "string" },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 }
      }
    },
    "source_reference": {
      "type": "object",
      "required": ["file_id", "start_line", "end_line", "reason"],
      "properties": {
        "file_id": { "type": "string", "minLength": 1 },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "reconciliation_partition": {
      "type": "object",
      "required": ["candidate_ids", "reason"],
      "properties": {
        "candidate_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "name": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "kind": { "type": "string" },
        "responsibility": { "type": "string" },
        "file_ids": { "type": "array", "items": { "type": "string" } },
        "symbol_canonical_keys": { "type": "array", "items": { "type": "string" } },
        "owned_source_refs": { "type": "array", "items": { "$ref": "#/$defs/source_reference" } },
        "supporting_source_refs": { "type": "array", "items": { "$ref": "#/$defs/source_reference" } },
        "reason": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "architecture_horizontal_module": {
      "type": "object",
      "required": ["module_id", "name", "summary", "component_ids"],
      "properties": {
        "module_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "component_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "architecture_horizontal": {
      "type": "object",
      "required": ["repository_purpose", "external_boundaries", "entry_surfaces", "modules", "relationships", "state", "build", "tests", "constraints"],
      "properties": {
        "repository_purpose": {},
        "external_boundaries": { "type": "array" },
        "entry_surfaces": { "type": "array" },
        "modules": { "type": "array", "items": { "$ref": "#/$defs/architecture_horizontal_module" } },
        "relationships": { "type": "array", "items": { "type": "string" } },
        "state": {},
        "build": {},
        "tests": {},
        "constraints": {}
      }
    },
    "architecture_step": {
      "type": "object",
      "required": ["order", "module_id", "component_ids", "summary", "symbol_locators", "source_refs"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "module_id": { "type": "string", "minLength": 1 },
        "component_ids": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string", "minLength": 1 },
        "symbol_locators": { "type": "array", "items": { "$ref": "#/$defs/symbol_locator" } },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/source_reference" } }
      }
    },
    "architecture_vertical_slice": {
      "type": "object",
      "required": ["id", "title", "ordered_steps", "alternate_flows", "error_flows", "dynamic_behavior", "unresolved"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "ordered_steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/architecture_step" } },
        "alternate_flows": { "type": "array" },
        "error_flows": { "type": "array" },
        "dynamic_behavior": { "type": "array" },
        "unresolved": { "type": "array" }
      }
    },
    "module_horizontal": {
      "type": "object",
      "required": ["purpose", "interfaces", "relationship_ids", "configuration", "state", "tests", "risks", "peer_navigation"],
      "properties": {
        "purpose": {},
        "interfaces": { "type": "array" },
        "relationship_ids": { "type": "array", "items": { "type": "string" } },
        "configuration": {},
        "state": {},
        "tests": {},
        "risks": {},
        "peer_navigation": { "type": "array" }
      }
    },
    "module_vertical_component": {
      "type": "object",
      "required": ["component_id", "summary"],
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "module_vertical": {
      "type": "object",
      "required": ["components", "initialization", "normal_flow", "alternate_flow", "errors", "data", "concurrency", "important_functions"],
      "properties": {
        "components": { "type": "array", "items": { "$ref": "#/$defs/module_vertical_component" } },
        "initialization": {},
        "normal_flow": {},
        "alternate_flow": {},
        "errors": {},
        "data": {},
        "concurrency": {},
        "important_functions": { "type": "array", "items": { "$ref": "#/$defs/symbol_locator" } }
      }
    },
    "call_edge": {
      "type": "object",
      "required": ["from_symbol_key", "to_symbol_key", "confidence", "summary"],
      "properties": {
        "from_symbol_key": { "type": "string", "minLength": 1 },
        "to_symbol_key": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["direct", "inferred", "dynamic", "unresolved"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "diagram": {
      "type": "object",
      "required": ["id", "type", "node_ids", "relationship_ids", "mermaid"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "node_ids": { "type": "array", "items": { "type": "string" } },
        "relationship_ids": { "type": "array", "items": { "type": "string" } },
        "mermaid": { "type": "string", "minLength": 1 }
      }
    },
    "deep_link": {
      "type": "object",
      "required": ["target_type", "target_id"],
      "properties": {
        "target_type": { "type": "string", "minLength": 1 },
        "target_id": { "type": "string", "minLength": 1 }
      }
    },
    "source_file": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["id", "path", "content_hash", "size", "source_status"],
          "properties": {
            "record_type": { "const": "source_file" },
            "id": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "content_hash": { "type": "string", "minLength": 1 },
            "size": { "type": "integer", "minimum": 0 },
            "source_status": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "component_candidate": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": [
            "analysis_run_id",
            "repository_revision",
            "candidate_id",
            "name",
            "name_origin",
            "kind",
            "responsibility",
            "file_ids",
            "symbols",
            "owned_source_refs",
            "supporting_source_refs",
            "confidence",
            "limitations"
          ],
          "properties": {
            "record_type": { "const": "component_candidate" },
            "analysis_run_id": { "type": "string", "minLength": 1 },
            "repository_revision": { "type": "string", "minLength": 1 },
            "candidate_id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "name_origin": { "enum": ["source_defined", "inferred"] },
            "kind": { "type": "string", "minLength": 1 },
            "responsibility": { "type": "string", "minLength": 1 },
            "file_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbol_locator" } },
            "owned_source_refs": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/source_reference" }
            },
            "supporting_source_refs": {
              "type": "array",
              "items": { "$ref": "#/$defs/source_reference" }
            },
            "confidence": { "enum": ["verified", "high", "medium", "low", "unknown"] },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "overlap_group": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["id", "candidate_ids", "shared_symbol_edges"],
          "properties": {
            "record_type": { "const": "overlap_group" },
            "id": { "type": "string" },
            "candidate_ids": { "type": "array", "minItems": 2, "items": { "type": "string" } },
            "shared_symbol_edges": { "type": "array", "minItems": 1, "items": { "type": "object" } }
          }
        }
      ]
    },
    "component_reconciliation": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["repository_revision", "analysis_run_id", "overlap_group_id", "decision", "partitions", "reason", "limitations"],
          "properties": {
            "record_type": { "const": "component_reconciliation" },
            "repository_revision": { "type": "string", "minLength": 1 },
            "analysis_run_id": { "type": "string", "minLength": 1 },
            "overlap_group_id": { "type": "string", "minLength": 1 },
            "decision": { "enum": ["same", "distinct"] },
            "partitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reconciliation_partition" } },
            "reason": { "type": "string", "minLength": 1 },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "component": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["id", "name", "kind", "responsibility", "file_ids"],
          "properties": {
            "record_type": { "const": "component" },
            "id": { "type": "string" },
            "name": { "type": "string" },
            "kind": { "type": "string" },
            "responsibility": { "type": "string" },
            "file_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbol_locator" } }
          }
        }
      ]
    },
    "file_disposition": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["file_id", "disposition", "component_ids"],
          "properties": {
            "record_type": { "const": "file_disposition" },
            "file_id": { "type": "string" },
            "disposition": { "enum": ["owned", "supporting", "repository_infrastructure", "excluded", "unresolved"] },
            "component_ids": { "type": "array", "items": { "type": "string" } },
            "reason": { "type": "string" }
          }
        }
      ]
    },
    "source_manifest": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        { "type": "object", "required": ["id", "status", "file_ids", "raw_tag_count"], "properties": { "record_type": { "const": "source_manifest" } } }
      ]
    },
    "component_manifest": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        { "type": "object", "required": ["id", "status", "component_ids", "coverage_path"], "properties": { "record_type": { "const": "component_manifest" } } }
      ]
    },
    "module_manifest": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        { "type": "object", "required": ["id", "status", "module_ids", "frozen"], "properties": { "record_type": { "const": "module_manifest" } } }
      ]
    },
    "file_coverage": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        { "type": "object", "required": ["in_scope_count", "owned_count", "supporting_count", "repository_infrastructure_count", "excluded_count", "unresolved_count", "unresolved_file_ids"], "properties": { "record_type": { "const": "file_coverage" } } }
      ]
    },
    "module": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["repository_revision", "id", "name", "kind", "purpose", "responsibility", "component_ids", "primary_component_ids", "entry_component_ids", "primary_for_component_ids", "grouping_rationale", "source_refs", "confidence", "limitations"],
          "properties": {
            "record_type": { "const": "module" },
            "repository_revision": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "purpose": { "type": "string", "minLength": 1 },
            "responsibility": { "type": "string", "minLength": 1 },
            "component_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "primary_component_ids": { "type": "array", "items": { "type": "string" } },
            "entry_component_ids": { "type": "array", "items": { "type": "string" } },
            "primary_for_component_ids": { "type": "array", "items": { "type": "string" } },
            "grouping_rationale": { "type": "string", "minLength": 1 },
            "source_refs": { "type": "array", "items": { "$ref": "#/$defs/source_reference" } },
            "confidence": { "enum": ["verified", "high", "medium", "low", "unknown"] },
            "limitations": { "type": "array", "items": { "type": "string" } },
            "parent_module_id": { "type": ["string", "null"] },
            "repeated_component_rationales": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      ]
    },
    "module_relationship": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["repository_revision", "id", "from_module_id", "to_module_id", "kind", "summary", "direction", "condition", "confidence", "supporting_component_ids", "source_refs", "limitations"],
          "properties": {
            "record_type": { "const": "module_relationship" },
            "repository_revision": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "from_module_id": { "type": "string", "minLength": 1 },
            "to_module_id": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 },
            "direction": { "enum": ["directed", "bidirectional"] },
            "condition": { "type": "string" },
            "confidence": { "enum": ["verified", "high", "medium", "low", "unknown"] },
            "supporting_component_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source_reference" } },
            "limitations": { "type": "array", "items": { "type": "string" } },
            "self_relationship_reason": { "type": "string" }
          }
        }
      ]
    },
    "architecture_knowledge": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["repository_revision", "id", "title", "body", "module_ids", "component_ids", "horizontal", "vertical_slices", "diagrams", "deep_links", "limitations"],
          "properties": {
            "record_type": { "const": "architecture_knowledge" },
            "repository_revision": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "generated_id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 },
            "module_ids": { "type": "array", "items": { "type": "string" } },
            "component_ids": { "type": "array", "items": { "type": "string" } },
            "horizontal": { "$ref": "#/$defs/architecture_horizontal" },
            "vertical_slices": { "type": "array", "items": { "$ref": "#/$defs/architecture_vertical_slice" } },
            "diagrams": { "type": "array", "items": { "$ref": "#/$defs/diagram" } },
            "deep_links": { "type": "array", "items": { "$ref": "#/$defs/deep_link" } },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "module_knowledge": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["repository_revision", "id", "module_id", "title", "body", "module_ids", "component_ids", "horizontal", "vertical", "diagrams", "peer_links", "deep_links", "intentional_component_overlap", "limitations"],
          "properties": {
            "record_type": { "const": "module_knowledge" },
            "repository_revision": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "module_id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 },
            "module_ids": { "type": "array", "items": { "type": "string" } },
            "component_ids": { "type": "array", "items": { "type": "string" } },
            "horizontal": { "$ref": "#/$defs/module_horizontal" },
            "vertical": { "$ref": "#/$defs/module_vertical" },
            "diagrams": { "type": "array", "items": { "$ref": "#/$defs/diagram" } },
            "peer_links": { "type": "array", "items": { "$ref": "#/$defs/deep_link" } },
            "deep_links": { "type": "array", "items": { "$ref": "#/$defs/deep_link" } },
            "intentional_component_overlap": { "type": "array" },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "function_knowledge": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["repository_revision", "id", "title", "body", "symbol", "component_ids", "module_ids", "purpose", "contract", "local_flow", "callers", "callees", "state", "errors", "concurrency", "tests", "limitations", "call_edges", "diagrams"],
          "properties": {
            "record_type": { "const": "function_knowledge" },
            "repository_revision": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 },
            "symbol": { "$ref": "#/$defs/symbol_locator" },
            "component_ids": { "type": "array", "items": { "type": "string" } },
            "module_ids": { "type": "array", "items": { "type": "string" } },
            "purpose": {},
            "contract": {},
            "local_flow": {},
            "callers": { "type": "array", "items": { "$ref": "#/$defs/symbol_locator" } },
            "callees": { "type": "array", "items": { "$ref": "#/$defs/symbol_locator" } },
            "state": {},
            "errors": {},
            "concurrency": {},
            "tests": {},
            "limitations": { "type": "array" },
            "call_edges": { "type": "array", "items": { "$ref": "#/$defs/call_edge" } },
            "diagrams": { "type": "array", "items": { "$ref": "#/$defs/diagram" } }
          }
        }
      ]
    },
    "knowledge_request": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["repository_revision", "id", "request_type", "status", "reason"],
          "properties": {
            "record_type": { "const": "knowledge_request" },
            "repository_revision": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "request_type": { "enum": ["missing_file", "missing_component", "missing_endpoint", "missing_knowledge"] },
            "status": { "enum": ["open", "resolved", "dismissed"] },
            "reason": { "type": "string", "minLength": 1 },
            "source_refs": { "type": "array", "items": { "$ref": "#/$defs/source_reference" } },
            "related_record_ids": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "diagnostic": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["id", "severity", "code", "message"],
          "properties": {
            "record_type": { "const": "diagnostic" },
            "id": { "type": "string" },
            "severity": { "enum": ["info", "warning", "fatal"] },
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      ]
    }
  }
}
