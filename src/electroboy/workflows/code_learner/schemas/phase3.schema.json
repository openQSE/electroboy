{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electroboy.local/schemas/code-learner-phase3.schema.json",
  "title": "ElectroBoy Code Learner Phase 3 Record",
  "oneOf": [
    { "$ref": "#/$defs/source_file" },
    { "$ref": "#/$defs/component_candidate" },
    { "$ref": "#/$defs/overlap_group" },
    { "$ref": "#/$defs/component_reconciliation" },
    { "$ref": "#/$defs/component" },
    { "$ref": "#/$defs/file_disposition" },
    { "$ref": "#/$defs/source_manifest" },
    { "$ref": "#/$defs/component_manifest" },
    { "$ref": "#/$defs/module_manifest" },
    { "$ref": "#/$defs/file_coverage" },
    { "$ref": "#/$defs/module" },
    { "$ref": "#/$defs/module_relationship" },
    { "$ref": "#/$defs/architecture_knowledge" },
    { "$ref": "#/$defs/module_knowledge" },
    { "$ref": "#/$defs/function_knowledge" },
    { "$ref": "#/$defs/knowledge_request" },
    { "$ref": "#/$defs/diagnostic" }
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": ["schema_version", "record_type"],
      "properties": {
        "schema_version": { "const": 1 },
        "record_type": { "type": "string", "minLength": 1 },
        "repository_revision": { "type": "string" }
      }
    },
    "symbol_locator": {
      "type": "object",
      "required": ["file_id", "name", "kind", "start_line", "end_line"],
      "properties": {
        "file_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" },
        "language": { "type": "string" },
        "signature": { "type": "string" },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 }
      }
    },
    "source_reference": {
      "type": "object",
      "required": ["file_id", "start_line", "end_line", "reason"],
      "properties": {
        "file_id": { "type": "string", "minLength": 1 },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "source_file": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["id", "path", "content_hash", "size", "source_status"],
          "properties": {
            "record_type": { "const": "source_file" },
            "id": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "content_hash": { "type": "string", "minLength": 1 },
            "size": { "type": "integer", "minimum": 0 },
            "source_status": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "component_candidate": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": [
            "analysis_run_id",
            "repository_revision",
            "candidate_id",
            "name",
            "name_origin",
            "kind",
            "responsibility",
            "file_ids",
            "symbols",
            "owned_source_refs",
            "supporting_source_refs",
            "confidence",
            "limitations"
          ],
          "properties": {
            "record_type": { "const": "component_candidate" },
            "analysis_run_id": { "type": "string", "minLength": 1 },
            "repository_revision": { "type": "string", "minLength": 1 },
            "candidate_id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "name_origin": { "enum": ["source_defined", "inferred"] },
            "kind": { "type": "string", "minLength": 1 },
            "responsibility": { "type": "string", "minLength": 1 },
            "file_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbol_locator" } },
            "owned_source_refs": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/source_reference" }
            },
            "supporting_source_refs": {
              "type": "array",
              "items": { "$ref": "#/$defs/source_reference" }
            },
            "confidence": { "enum": ["verified", "high", "medium", "low", "unknown"] },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "overlap_group": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["id", "candidate_ids", "shared_symbol_edges"],
          "properties": {
            "record_type": { "const": "overlap_group" },
            "id": { "type": "string" },
            "candidate_ids": { "type": "array", "minItems": 2, "items": { "type": "string" } },
            "shared_symbol_edges": { "type": "array", "minItems": 1, "items": { "type": "object" } }
          }
        }
      ]
    },
    "component_reconciliation": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["overlap_group_id", "decision", "partitions"],
          "properties": {
            "record_type": { "const": "component_reconciliation" },
            "overlap_group_id": { "type": "string" },
            "decision": { "enum": ["same", "distinct"] },
            "partitions": { "type": "array", "minItems": 1, "items": { "type": "object" } }
          }
        }
      ]
    },
    "component": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["id", "name", "kind", "responsibility", "file_ids"],
          "properties": {
            "record_type": { "const": "component" },
            "id": { "type": "string" },
            "name": { "type": "string" },
            "kind": { "type": "string" },
            "responsibility": { "type": "string" },
            "file_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbol_locator" } }
          }
        }
      ]
    },
    "file_disposition": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["file_id", "disposition", "component_ids"],
          "properties": {
            "record_type": { "const": "file_disposition" },
            "file_id": { "type": "string" },
            "disposition": { "enum": ["owned", "supporting", "repository_infrastructure", "excluded", "unresolved"] },
            "component_ids": { "type": "array", "items": { "type": "string" } },
            "reason": { "type": "string" }
          }
        }
      ]
    },
    "source_manifest": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        { "type": "object", "required": ["id", "status", "file_ids", "raw_tag_count"], "properties": { "record_type": { "const": "source_manifest" } } }
      ]
    },
    "component_manifest": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        { "type": "object", "required": ["id", "status", "component_ids", "coverage_path"], "properties": { "record_type": { "const": "component_manifest" } } }
      ]
    },
    "module_manifest": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        { "type": "object", "required": ["id", "status", "module_ids", "frozen"], "properties": { "record_type": { "const": "module_manifest" } } }
      ]
    },
    "file_coverage": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        { "type": "object", "required": ["in_scope_count", "owned_count", "supporting_count", "repository_infrastructure_count", "excluded_count", "unresolved_count", "unresolved_file_ids"], "properties": { "record_type": { "const": "file_coverage" } } }
      ]
    },
    "module": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["id", "name", "kind", "purpose", "component_ids"],
          "properties": {
            "record_type": { "const": "module" },
            "id": { "type": "string" },
            "name": { "type": "string" },
            "kind": { "type": "string" },
            "purpose": { "type": "string" },
            "component_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "parent_module_id": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "module_relationship": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["id", "from_module_id", "to_module_id", "kind", "summary"],
          "properties": {
            "record_type": { "const": "module_relationship" },
            "id": { "type": "string" },
            "from_module_id": { "type": "string" },
            "to_module_id": { "type": "string" },
            "kind": { "type": "string" },
            "summary": { "type": "string" },
            "supporting_component_ids": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "architecture_knowledge": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        { "type": "object", "required": ["id", "title", "body"], "properties": { "record_type": { "const": "architecture_knowledge" } } }
      ]
    },
    "module_knowledge": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        { "type": "object", "required": ["id", "module_id", "title", "body"], "properties": { "record_type": { "const": "module_knowledge" } } }
      ]
    },
    "function_knowledge": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        { "type": "object", "required": ["id", "symbol", "title", "body"], "properties": { "record_type": { "const": "function_knowledge" } } }
      ]
    },
    "knowledge_request": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        { "type": "object", "required": ["id", "request_type", "status", "reason"], "properties": { "record_type": { "const": "knowledge_request" } } }
      ]
    },
    "diagnostic": {
      "allOf": [
        { "$ref": "#/$defs/header" },
        {
          "type": "object",
          "required": ["id", "severity", "code", "message"],
          "properties": {
            "record_type": { "const": "diagnostic" },
            "id": { "type": "string" },
            "severity": { "enum": ["info", "warning", "fatal"] },
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      ]
    }
  }
}
