{
  "$schema": "vscode://schemas/color-theme",
  "name": "ElectroBoy",
  "type": "dark",
  "colors": {
    "activityBar.background": "#151B29",
    "activityBar.foreground": "#E7EDF7",
    "activityBar.inactiveForeground": "#8290A8",
    "activityBarBadge.background": "#0F766E",
    "activityBarBadge.foreground": "#FFFFFF",
    "activityBar.border": "#364156",
    "badge.background": "#0F766E",
    "badge.foreground": "#FFFFFF",
    "button.background": "#0F766E",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#12877E",
    "button.secondaryBackground": "#1D2638",
    "button.secondaryForeground": "#E7EDF7",
    "button.secondaryHoverBackground": "#263550",
    "checkbox.background": "#10141F",
    "checkbox.border": "#52647E",
    "commandCenter.background": "#1D2638",
    "commandCenter.border": "#364156",
    "commandCenter.foreground": "#E7EDF7",
    "commandCenter.activeBackground": "#263550",
    "descriptionForeground": "#AAB8CF",
    "dropdown.background": "#1D2638",
    "dropdown.border": "#364156",
    "editor.background": "#10141F",
    "editor.foreground": "#E7EDF7",
    "editor.findMatchBackground": "#8A5A00",
    "editor.findMatchHighlightBackground": "#5E471D",
    "editor.hoverHighlightBackground": "#1D3041",
    "editor.lineHighlightBackground": "#151B29",
    "editor.rangeHighlightBackground": "#1B3548",
    "editor.selectionBackground": "#234B61",
    "editor.inactiveSelectionBackground": "#1B3548",
    "editorCursor.foreground": "#66D9E8",
    "editorError.foreground": "#FF9B9B",
    "editorWarning.foreground": "#FFCF70",
    "editorInfo.foreground": "#66D9E8",
    "editorGroup.border": "#364156",
    "editorGroupHeader.tabsBackground": "#151B29",
    "editorGroupHeader.noTabsBackground": "#151B29",
    "editorLineNumber.foreground": "#68758A",
    "editorLineNumber.activeForeground": "#C7D2E3",
    "editorWidget.background": "#151B29",
    "editorWidget.border": "#364156",
    "editorSuggestWidget.background": "#151B29",
    "editorSuggestWidget.border": "#364156",
    "editorSuggestWidget.selectedBackground": "#1F6F8B",
    "focusBorder": "#66D9E8",
    "foreground": "#E7EDF7",
    "icon.foreground": "#C7D2E3",
    "input.background": "#10141F",
    "input.border": "#364156",
    "input.foreground": "#E7EDF7",
    "input.placeholderForeground": "#8290A8",
    "inputOption.activeBackground": "#1F6F8B",
    "inputOption.activeBorder": "#66D9E8",
    "keybindingLabel.background": "#1D2638",
    "keybindingLabel.border": "#52647E",
    "keybindingLabel.foreground": "#E7EDF7",
    "list.activeSelectionBackground": "#0F766E",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.hoverBackground": "#1D3041",
    "list.focusBackground": "#1F6F8B",
    "list.inactiveSelectionBackground": "#263550",
    "menu.background": "#151B29",
    "menu.foreground": "#E7EDF7",
    "menu.border": "#364156",
    "menu.selectionBackground": "#1F6F8B",
    "menu.selectionForeground": "#FFFFFF",
    "menubar.selectionBackground": "#263550",
    "minimap.background": "#10141F",
    "notificationCenterHeader.background": "#1D2638",
    "notificationCenter.border": "#364156",
    "notifications.background": "#151B29",
    "notifications.border": "#364156",
    "notifications.foreground": "#E7EDF7",
    "panel.background": "#10141F",
    "panel.border": "#364156",
    "panelTitle.activeBorder": "#66D9E8",
    "panelTitle.activeForeground": "#FFFFFF",
    "panelTitle.inactiveForeground": "#AAB8CF",
    "peekView.border": "#66D9E8",
    "peekViewEditor.background": "#10141F",
    "peekViewResult.background": "#151B29",
    "pickerGroup.border": "#364156",
    "pickerGroup.foreground": "#66D9E8",
    "progressBar.background": "#0F766E",
    "quickInput.background": "#151B29",
    "quickInput.foreground": "#E7EDF7",
    "quickInputList.focusBackground": "#1F6F8B",
    "scrollbar.shadow": "#00000066",
    "scrollbarSlider.activeBackground": "#8290A899",
    "scrollbarSlider.background": "#52647E66",
    "scrollbarSlider.hoverBackground": "#68758A88",
    "settings.checkboxBackground": "#10141F",
    "settings.checkboxBorder": "#52647E",
    "settings.dropdownBackground": "#1D2638",
    "settings.dropdownBorder": "#364156",
    "settings.headerForeground": "#FFFFFF",
    "settings.modifiedItemIndicator": "#66D9E8",
    "sideBar.background": "#151B29",
    "sideBar.border": "#364156",
    "sideBar.foreground": "#C7D2E3",
    "sideBarSectionHeader.background": "#1D2638",
    "statusBar.background": "#0F766E",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.noFolderBackground": "#364156",
    "statusBar.debuggingBackground": "#8A5A00",
    "statusBarItem.hoverBackground": "#12877E",
    "statusBarItem.remoteBackground": "#1F6F8B",
    "tab.activeBackground": "#10141F",
    "tab.activeBorderTop": "#66D9E8",
    "tab.activeForeground": "#FFFFFF",
    "tab.border": "#364156",
    "tab.inactiveBackground": "#151B29",
    "tab.inactiveForeground": "#AAB8CF",
    "tab.hoverBackground": "#1D3041",
    "terminal.background": "#10141F",
    "terminal.foreground": "#E7EDF7",
    "terminal.tab.activeBorder": "#66D9E8",
    "textLink.activeForeground": "#8BE9F4",
    "textLink.foreground": "#66D9E8",
    "titleBar.activeBackground": "#151B29",
    "titleBar.activeForeground": "#E7EDF7",
    "titleBar.border": "#364156",
    "titleBar.inactiveBackground": "#151B29",
    "titleBar.inactiveForeground": "#8290A8",
    "toolbar.activeBackground": "#263550",
    "toolbar.hoverBackground": "#1D3041",
    "tree.indentGuidesStroke": "#364156",
    "welcomePage.background": "#10141F",
    "welcomePage.tileBackground": "#1D2638",
    "welcomePage.tileHoverBackground": "#263550",
    "widget.border": "#364156"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {"foreground": "#8290A8", "fontStyle": "italic"}
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {"foreground": "#66D9E8"}
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": {"foreground": "#A7D7A9"}
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {"foreground": "#F0C674"}
    },
    {
      "scope": ["variable", "meta.definition.variable.name"],
      "settings": {"foreground": "#E7EDF7"}
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": {"foreground": "#D7A7E8"}
    }
  ]
}
