{
  "name": "electroboy-bridge",
  "displayName": "ElectroBoy IDE Bridge",
  "description": "Workspace context and navigation bridge for ElectroBoy.",
  "version": "1.4.0",
  "publisher": "electroboy",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "electroboy.neovim.sendKey",
        "title": "ElectroBoy: Send Key to Neovim"
      }
    ],
    "keybindings": [
      {
        "command": "electroboy.neovim.sendKey",
        "key": "up",
        "when": "editorTextFocus && neovim.init && neovim.mode != insert",
        "args": "<up>"
      },
      {
        "command": "electroboy.neovim.sendKey",
        "key": "down",
        "when": "editorTextFocus && neovim.init && neovim.mode != insert",
        "args": "<down>"
      },
      {
        "command": "electroboy.neovim.sendKey",
        "key": "left",
        "when": "editorTextFocus && neovim.init && neovim.mode != insert",
        "args": "<left>"
      },
      {
        "command": "electroboy.neovim.sendKey",
        "key": "right",
        "when": "editorTextFocus && neovim.init && neovim.mode != insert",
        "args": "<right>"
      }
    ],
    "configuration": {
      "title": "ElectroBoy IDE Bridge",
      "properties": {
        "electroboy.bridge.directory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Managed bridge directory. ElectroBoy configures this value."
        }
      }
    }
  }
}
