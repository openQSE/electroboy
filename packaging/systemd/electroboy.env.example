# Example only. `electroboy service install` writes the real env file to
# ~/.config/electroboy/service.env for a user service, or /etc/default/electroboy
# for a system service.

# GUI browse/base directory. This does not auto-open a project or select a
# meta-project repository.
ELECTROBOY_SERVICE_ROOT=/home/YOUR_USER

# Bind localhost by default. Use 0.0.0.0 only when network exposure is intended.
ELECTROBOY_SERVICE_HOST=127.0.0.1

# Browser URL port.
ELECTROBOY_SERVICE_PORT=8765

# systemd does not inherit your interactive shell PATH at start time.
PATH=/home/YOUR_USER/.local/bin:/usr/local/bin:/usr/bin:/bin
